using Gtk 4.0;
using Adw 1;

template $HolocttyVerticalTabBar: Box {
  styles [
    "vertical-tabs",
  ]

  orientation: vertical;
  notify::view => $notify_view();
  map => $mapped();

  DropTarget tab_bar_drop_target {
    actions: move;
    preload: true;
    drop => $tab_bar_drop();
  }

  ScrolledWindow scrolled_window {
    hscrollbar-policy: never;
    // Generous upper bound so remembered paned widths can grow; the
    // actual sidebar width is controlled by the window's Gtk.Paned.
    max-content-width: 800;
    min-content-width: 100;
    propagate-natural-width: true;
    vexpand: true;

    DropControllerMotion {
      motion => $drag_motion();
      leave => $drag_leave();
    }

    Box tab_list {
      hexpand: true;
      // Leave a consistent edge lane for the overlay scrollbar.
      margin-end: 6;
      orientation: vertical;
      valign: start;
    }
  }
}
