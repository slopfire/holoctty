using Gtk 4.0;
using Adw 1;

template $HolocttyVerticalTabBar: Box {
  styles [
    "vertical-tabs",
  ]

  orientation: vertical;

  DropTarget tab_bar_drop_target {
    actions: move;
    preload: true;
    drop => $tab_bar_drop();
  }

  ScrolledWindow scrolled_window {
    hscrollbar-policy: never;
    // Generous upper bound so remembered paned widths can grow; the
    // actual sidebar width is controlled by the window's Gtk.Paned.
    max-content-width: 800;
    min-content-width: 100;
    propagate-natural-width: true;
    vexpand: true;

    DropControllerMotion {
      motion => $drag_motion();
      leave => $drag_leave();
    }

    ListView {
      model: bind template.view as <Adw.TabView>.pages;
      show-separators: false;

      factory: BuilderListItemFactory {
        template ListItem {
          child: $HolocttyVerticalTab {
            page: bind template.item as <Adw.TabPage>;
          };
        }
      };
    }
  }
}
